# ─────────────────────────────────────────────────────────────────────────────
# Bilm Technical Services — Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values (especially SMTP + SECRET_KEY)
# 3. NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# ── Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# ── Email — choose "smtp" or "sendgrid"
EMAIL_PROVIDER=smtp

# Gmail SMTP (use App Password, NOT your account password)
# Enable at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Biali.kandi@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
SMTP_USE_TLS=true

EMAIL_FROM_NAME=Bilm Technical Services
EMAIL_FROM_ADDRESS=Biali.kandi@gmail.com
ADMIN_EMAIL=Biali.kandi@gmail.com

# SendGrid (alternative — leave blank if using SMTP)
SENDGRID_API_KEY=

# ── These are set directly in docker-compose.yml — no need to duplicate here
# DATABASE_URL, REDIS_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND
