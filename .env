# ─────────────────────────────────────────────────────────────────────────────
# Bilm Technical Services — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker: use service name "db". For local dev: use "localhost"
DATABASE_URL=postgresql+asyncpg://bilm:bilmpass@localhost:5432/bilmdb?ssl=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=f5b291cc6d517e1c58783573affc1aec8b4c66f35b8624e2124b9a058cb3d79a
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Email Provider ────────────────────────────────────────────────────────────
# Choose: "smtp" or "sendgrid"
EMAIL_PROVIDER=smtp

# SMTP (Gmail example — use an App Password, not your account password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bilmtechnicalservices@gmail.com
SMTP_PASSWORD=sgmizrxingysapgu
SMTP_USE_TLS=true


# SendGrid (alternative)
SENDGRID_API_KEY=

# From address (must match SMTP_USER or be verified in SendGrid)
EMAIL_FROM_NAME=Bilm Technical Services
EMAIL_FROM_ADDRESS=bilmtechnicalservices@gmail.com
ADMIN_EMAIL=Biali.kandi@gmail.com

# ── Company (fallbacks — primary values come from DB settings table) ───────────
